<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    tools:context=".Recomendaciones">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recomendaciones de películas"
        android:textSize="24sp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etGenero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingresa un género"
        android:inputType="text"/>

    <Button
        android:id="@+id/btnRecomendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recomendar"
        android:layout_marginTop="15dp"/>

    <TextView
        android:id="@+id/tvRecomendaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Las recomendaciones aparecerán aquí"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Regresar"
        android:layout_marginTop="30dp"/>

</LinearLayout>